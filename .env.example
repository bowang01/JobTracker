# Variables used by docker-compose.prod.yml.
# In GitHub: Settings -> Secrets and variables -> Actions
#   Secrets:   HOSTINGER_API_KEY, JOBTRACK_ADMIN_PASSWORD, MYSQL_PASSWORD, MYSQL_ROOT_PASSWORD
#   Variables: HOSTINGER_VM_ID, JOBTRACK_ADMIN_EMAIL
# To run the production stack by hand, copy this to .env (never commit .env).
IMAGE_TAG=latest
JOBTRACK_ADMIN_EMAIL=admin@example.com
JOBTRACK_ADMIN_PASSWORD=change-me
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
# Optional: public demo account (on by default)
JOBTRACK_DEMO_ENABLED=true
JOBTRACK_DEMO_EMAIL=demo@jobtrack.co.nz
JOBTRACK_DEMO_PASSWORD=demo1234
